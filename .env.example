LOG_LEVEL=INFO
# Supabase: Project Settings > API (URL + clé service_role ou clé secrète sb_secret_...). Jamais dans le navigateur ni sur GitHub.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_KEY=
# Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODELS=gemini-3.5-flash,gemini-3.1-flash-lite,gemini-2.5-flash
CACHE_TTL_SECONDS=7200
HTTP_TIMEOUT_SECONDS=12
MAX_REQUESTS_PER_MINUTE=120
AI_MAX_PER_MINUTE=6
AI_DAILY_LIMIT=300
MAX_OBJECTS=3000
# Vide = même origine uniquement (recommandé). Exemple: https://mon-site.example
ALLOWED_ORIGINS=
